# Chave secreta do Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sua-chave-secreta-aqui

# URL de conexão do banco PostgreSQL (Neon) — prefira o endpoint "-pooler"
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/intranet_prod?sslmode=require

# Ambiente
FLASK_ENV=production
